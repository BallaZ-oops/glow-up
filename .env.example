# Telegram-бот для заявок (создать через @BotFather)
TELEGRAM_BOT_TOKEN=
# ID чата/группы/пользователя, куда слать заявки (только этот чат видит историю)
TELEGRAM_CHAT_ID=
# Произвольная случайная строка (A-Z a-z 0-9 _ -); тот же secret_token указывается в setWebhook
TELEGRAM_WEBHOOK_SECRET=
# Supabase: Project Settings -> API
SUPABASE_URL=
# service_role ключ (секретный, только на сервере, никогда на клиенте)
SUPABASE_SERVICE_ROLE_KEY=
# Необязательно: часовой пояс для дат в истории
TIMEZONE=Asia/Bishkek

# --- CRM / AI ---
# Ключ Anthropic для AI-чата (console.anthropic.com). Только на сервере, без префикса PUBLIC_.
ANTHROPIC_API_KEY=
# Необязательно: модель (по умолчанию claude-opus-5-5; для экономии можно claude-haiku-5-5)
ANTHROPIC_MODEL=
# Необязательно: соль для хеширования IP в лимитах запросов
RATE_LIMIT_SALT=
# Публичные значения для /admin (URL проекта и publishable-ключ; доступ защищён RLS)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
